# NovaFury MT5 bridge
MT5_ROOT=C:\Program Files\MetaTrader 5
SYMBOL=XAUUSD
TIMEFRAME=M5
MAGIC=987654
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8765
DEVIATION=50

# Additive XGBoost M5 entry confirmation
XGB_CONFIRMATION_ENABLED=1
XGB_THRESHOLD=0.58
XGB_TRAIN_BARS=600
XGB_HORIZON=3
XGB_MODEL_REFRESH_SEC=300
XGB_MIN_ROWS=160
XGB_MIN_VALIDATION_AUC=0.55


# Optional external AI supervisors (configure/activate in Dashboard > Settings > External AI supervisors).
# API keys are saved by the local Python bridge into .env.local and are never returned to React.
OPENAI_API_KEY=
OPENAI_ENABLED=0
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_API_KEY=
ANTHROPIC_ENABLED=0
ANTHROPIC_MODEL=claude-sonnet-5
# Legacy OpenAI compatibility flag/model. The bridge keeps these synchronized.
AI_BRAIN_ENABLED=0
AI_MODEL=gpt-5.4-mini
AI_REFRESH_SEC=30
AI_MIN_CONFIDENCE=0.72
AI_MAX_SPREAD_POINTS=80
AI_FAIL_CLOSED=1
AI_HTTP_TIMEOUT_SEC=8

# V2 Balanced Risk Guardian (enforced by bridge, not by dashboard state).
# Leave blank to require dashboard login/server confirmation; or list approved logins.
MT5_ALLOWED_LOGINS=
MAX_SPREAD_POINTS=80
BRAIN_MAX_SPREAD_POINTS=80
BRAIN_MIN_MARGIN_LEVEL=400
RISK_BASE_BASKET_PCT=0.0035
RISK_MAX_BASKET_PCT=0.0050
RISK_RECOVERY_RESERVE_PCT=0.0010
RISK_DAILY_LOSS_PCT=0.0200
RISK_MAX_PEAK_DD_PCT=0.0500
RISK_MAX_MARGIN_UTIL_PCT=0.25
RISK_MIN_MARGIN_LEVEL=400
RISK_STOP_ATR_MULTIPLIER=1.5
COMPOUND_MAX_BONUS_PCT=0.0005
COMPOUND_PROFIT_SHARE=0.25
BASKET_MIN_NET_PROFIT=1.00
ESTIMATED_ROUND_TRIP_COST_PER_LOT=0.0

# AI-confirmed retracement recovery; two fills maximum per basket.
RECOVERY_ENABLED=1
RECOVERY_ARM_ATR_MULTIPLIER=0.75
RECOVERY_PULLBACK_MIN_FRACTION=0.25
RECOVERY_PULLBACK_MAX_FRACTION=0.65
RECOVERY_PENDING_EXPIRY_MINUTES=30
RECOVERY_CHECK_SEC=5

# Broker-side initial SL is mandatory; trailing is additional protection.
SMART_PROFIT_ENABLED=1
SMART_PROFIT_TRAIL_POINTS=60
SMART_PROFIT_STEP_POINTS=5
SMART_PROFIT_BE_OFFSET_POINTS=0
SMART_PROFIT_CHECK_SEC=0.25
SMART_BULK_EXIT_ENABLED=1
SMART_BULK_EXIT_CHECK_US=500000
SMART_BULK_EXIT_MAX_WORKERS=10

# Multi-model XAUUSD M5 AI confirmation brain (local Python bridge)
AI_ENSEMBLE_ENABLED=1
AI_ENSEMBLE_MODELS=lightgbm,catboost,meta
AI_ENSEMBLE_THRESHOLD=0.60
AI_META_THRESHOLD=0.58
AI_ENSEMBLE_TRAIN_BARS=4000
AI_ENSEMBLE_MIN_BARS=700
AI_ENSEMBLE_HORIZON=3
AI_ENSEMBLE_REFRESH_SEC=900
AI_MIN_VALIDATION_AUC=0.55
AI_SESSION_FEATURES=1

# Optional deep sequence model: install bridge/requirements-ai-deep.txt first
# Then set AI_SEQUENCE_ENABLED=1 and choose AI_SEQUENCE_ARCH=gru or tcn
AI_SEQUENCE_ENABLED=0
AI_SEQUENCE_ARCH=gru
AI_SEQUENCE_MIN_BARS=2500
AI_SEQUENCE_LENGTH=32

# Unified cross-brain coordinator. XGBoost and the inner LightGBM/CatBoost/
# optional GRU/TCN ensemble vote together; meta-labeling is a separate quality gate.
# Enabled external AI supervisors receive the individual outputs and weighted consensus as final risk gate.
BRAIN_XGB_WEIGHT=0.35
BRAIN_ENSEMBLE_WEIGHT=0.65
BRAIN_CONSENSUS_THRESHOLD=0.60
BRAIN_REQUIRE_XGB=1
BRAIN_REQUIRE_ENSEMBLE=1
BRAIN_MAX_SPREAD_POINTS=80
BRAIN_MIN_MARGIN_LEVEL=400
